#!/bin/sh

# Push the current branch after each successful commit.
if [ "$SKIP_AUTO_PUSH" = "1" ]; then
  exit 0
fi

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" || exit 0

if ! git remote get-url origin >/dev/null 2>&1; then
  echo "[post-commit] Skipping auto-push: remote 'origin' is not configured." >&2
  exit 0
fi

if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
  git push --quiet
else
  git push --quiet -u origin "$branch"
fi

status=$?
if [ "$status" -ne 0 ]; then
  echo "[post-commit] Auto-push failed; run 'git push' manually." >&2
fi

exit 0
